{
  "name": "@agent-harness/client",
  "version": "0.1.0",
  "description": "Zero-dependency, cross-runtime (Web / Node / React Native / Edge) typed HTTP client for the agent-harness /api/v1 server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/smoke.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.19.43"
  }
}
