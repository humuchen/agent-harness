# =============================================================================
# 敏感配置 —— 禁止把真实密钥提交进 git！
#
# ⚠️ 安全事件记录：本文件早期版本曾把 UI_AUTH_TOKEN 与 REDIS_PASSWORD 的
#    明文提交进仓库历史（已用 git filter-branch 清洗，并加入 .gitignore）。
#    任何曾克隆过本仓库的人都可能持有旧凭据 —— 请立即到对应后台轮换：
#      · OpenRouter API Key（若曾填写）
#      · Redis 密码（REDIS_PASSWORD）
#      · UI_AUTH_TOKEN（面板承载令牌）
#
# 生产必须改用外部注入，而非把 Secret 落库：
#   · Sealed Secrets / External Secrets Operator / CSI 驱动
#   · 或部署前用 kubectl 注入（见下方命令），本文件只保留占位：
#
#   kubectl -n agent-harness create secret generic agent-harness \
#     --from-literal=UI_AUTH_TOKEN='<强随机>' \
#     --from-literal=OPENROUTER_API_KEY='sk-or-...' \
#     --from-literal=REDIS_URL='redis://:PASSWORD@redis:6379' \
#     --from-literal=REDIS_PASSWORD='PASSWORD' \
#     --from-literal=HARNESS_API_KEY='' \
#     --from-literal=HARNESS_ACCOUNT_ID='' \
#     --from-literal=HARNESS_ORG_ID='' \
#     --from-literal=HARNESS_PROJECT_ID=''
#
# 占位值仅用于让 kubectl apply 通过；运行前务必用上面命令覆盖，
# 否则服务将开放（无令牌）或无法连接 Redis。
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: agent-harness
  namespace: agent-harness
  labels:
    app.kubernetes.io/part-of: agent-harness
type: Opaque
stringData:
  # 鉴权承载令牌。留空 = 不要求鉴权（全开放，仅限本地/快速验证）。
  # 生产必须设强随机值（建议经 Sealed Secrets / kubectl create secret 注入，勿落库）。
  UI_AUTH_TOKEN: ""
  # OpenRouter Key。留空则降级为 mock LLM。生产经 kubectl create secret 注入。
  OPENROUTER_API_KEY: ""
  OPENROUTER_MODEL: "agnes-2.5-flash"
  # Redis 凭据。生产必须带强随机密码，且经 kubectl create secret 注入，勿提交明文。
  REDIS_URL: "redis://redis:6379"
  REDIS_PASSWORD: ""
  HARNESS_API_KEY: ""
  HARNESS_ACCOUNT_ID: ""
  HARNESS_ORG_ID: ""
  HARNESS_PROJECT_ID: ""
