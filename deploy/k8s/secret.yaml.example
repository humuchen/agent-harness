# =============================================================================
# 敏感配置 —— 禁止把真实密钥提交进 git！
#
# ⚠️ 安全事件记录：本文件早期版本曾把 REDIS_PASSWORD 的明文提交进仓库历史。
#
# 生产必须改用外部注入，而非把 Secret 落库：
#   · Sealed Secrets / External Secrets Operator / CSI 驱动
#   · 或部署前用 kubectl 注入（见下方命令），本文件只保留占位：
#
#   kubectl -n agent-harness create secret generic agent-harness \
#     --from-literal=OPEN_API_KEY='sk-or-...' \
#     --from-literal=REDIS_URL='redis://:PASSWORD@redis:6379' \
#     --from-literal=REDIS_PASSWORD='PASSWORD' \
#     --from-literal=HARNESS_API_KEY='' \
#     --from-literal=HARNESS_ACCOUNT_ID='' \
#     --from-literal=HARNESS_ORG_ID='' \
#     --from-literal=HARNESS_PROJECT_ID=''
#
# 占位值仅用于让 kubectl apply 通过；运行前务必用上面命令覆盖，
# 否则服务将开放（无令牌）或无法连接 Redis。
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: agent-harness
  namespace: agent-harness
  labels:
    app.kubernetes.io/part-of: agent-harness
type: Opaque
stringData:
  # OpenRouter Key。留空则降级为 mock LLM。生产经 kubectl create secret 注入。
  OPEN_API_KEY: ""
  OPEN_MODEL: ""
  # Redis 凭据。生产必须带强随机密码，且经 kubectl create secret 注入，勿提交明文。
  REDIS_URL: "redis://redis:6379"
  REDIS_PASSWORD: ""
  HARNESS_API_KEY: ""
  HARNESS_ACCOUNT_ID: ""
  HARNESS_ORG_ID: ""
  HARNESS_PROJECT_ID: ""
