{
  "name": "agent-harness-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "Monorepo for agent-harness: @agent-harness/core (framework) + @agent-harness/server (HTTP+SSE server).",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "build:native": "bash scripts/build-native.sh",
    "verify:sandbox": "bash scripts/verify-sandbox.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:load": "node scripts/load-test.cjs",
    "test:load:heavy": "node scripts/load-test.cjs -c 50 -r 500",
    "test:sse-reconnect": "node scripts/sse-reconnect-test.cjs",
    "test:capacity": "node scripts/capacity-benchmark.cjs",
    "create:plugin": "node scripts/create-plugin.cjs",
    "db:migrate": "node scripts/db-migrate.cjs",
    "server": "pnpm --filter @agent-harness/server run start",
    "dev": "node access/server/dist/server.js",
    "skills:core": "bash skills/ah-platform-evolution/scripts/build-and-test.sh core",
    "skills:server": "bash skills/ah-platform-evolution/scripts/build-and-test.sh server",
    "skills:test": "bash skills/ah-platform-evolution/scripts/build-and-test.sh test",
    "skills:lint": "bash skills/ah-platform-evolution/scripts/build-and-test.sh lint",
    "skills:all": "bash skills/ah-platform-evolution/scripts/build-and-test.sh all",
    "cleanup:retention": "node scripts/cleanup-retention.cjs --force",
    "cleanup:retention:dry-run": "node scripts/cleanup-retention.cjs --dry-run",
    "backup:db": "node scripts/backup-db.cjs --action backup",
    "backup:db:list": "node scripts/backup-db.cjs --action list",
    "backup:db:restore": "node scripts/backup-db.cjs --action restore",
    "drill:rollback": "node scripts/rollback-drill.cjs",
    "drill:rollback:verify": "node scripts/rollback-drill.cjs --action verify",
    "drill:rollback:backup": "node scripts/rollback-drill.cjs --action backup"
  },
  "license": "Apache License, Version 2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.68.0"
  }
}
