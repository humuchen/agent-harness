{
  // TS7 时代 IDE 语言服务配置（详见 tsrs docs/LSP.md）：
  // - 官方 typescript@7 与 tsrs 均不再提供经典 tsserver.js，经典 TS 扩展无服务可用；
  // - 语言服务经 `tsrs --lsp -stdio`（LSP）提供，需安装
  //   「TypeScript 7」扩展（TypeScriptTeam.native-preview）。
  // - 该扩展按约定在 tsdk 目录下查找名为 tsgo/tsc 的可执行文件，
  //   故以 .vscode/tsrs-tsdk/tsgo 符号链接指向 node_modules/tsrs/bin/tsrs。
  // - tsconfig.json 中 moduleResolution: "bundler" 及 svelte 通配模块声明
  "js/ts.tsdk.path": "${workspaceFolder}/.vscode/tsrs-tsdk",
  // 打开 .ts 文件时自动提示切换到工作区 TS 版本
  "typescript.enablePromptUseWorkspaceTsdk": true
}
