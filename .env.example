# ===== Real LLM (OpenRouter — default provider) =====
# Leave OPENROUTER_API_KEY empty to use the built-in mock LLM in examples.
# Get a key at https://openrouter.ai/keys  (store the REAL key in local .env, not here)
OPENROUTER_API_KEY=
# Provider-prefixed slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only if you use a self-hosted OpenRouter-compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=https://workbuddy.app
OPENROUTER_APP_NAME=agent-harness-ts

# ===== Real LLM (plain OpenAI-compatible, optional) =====
# Use createOpenAILLM() / this block for OpenAI / Azure / local vLLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Harness platform =====
# Leave HARNESS_API_KEY empty to run the agent in dry-run mode
# (it prints the exact API calls it would make, no real provisioning).
HARNESS_API_KEY=
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=
HARNESS_PROJECT_ID=
HARNESS_API_BASE=https://app.harness.io
HARNESS_PROVISION_PIPELINE_ID=provision-environment
HARNESS_DESTROY_PIPELINE_ID=destroy-ephemeral

# ===== Harness debug (align to your real instance) =====
# Set to 1 to print raw Harness trigger/status JSON — paste it back so we can
# fine-tune statusPath / doneStatuses to your instance's exact response shape.
HARNESS_DEBUG=

# ===== MCP (active when configured) =====
# Set MCP_SERVER_URL to plug a remote MCP server's tools into the agent.
# Transport is auto-detected: URL ending in /sse -> SSE, otherwise Streamable HTTP.
# Context7 (up-to-date library docs) is the first integration, already wired below.
MCP_SERVER_URL=https://mcp.context7.com/mcp
# Optional auth headers for the remote server, comma-separated KEY=VALUE.
# Context7 works without a key; add one (free at context7.com/dashboard) for higher limits:
# MCP_HEADERS=CONTEXT7_API_KEY=your_context7_key
MCP_HEADERS=
# Local server (stdio) alternative:
# MCP_COMMAND=npx
# MCP_ARGS=-y @upstash/context7-mcp
# 多服务（每项独立 transport / headers / command），优先级高于单 URL：
# MCP_SERVERS=[{"name":"context7","serverUrl":"https://mcp.context7.com/mcp","headers":{"CONTEXT7_API_KEY":"x"}},
#              {"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]

# ===== MCP 可靠性（自动重连 + 健康探测） =====
# 远端 server 重启 / 网络抖动时自动自愈。默认开启。
MCP_RECONNECT=true
# 自动重连最大尝试次数（达到后停止后台重试，可由 UI 手动「↻ 重连」）。默认 5。
MCP_RECONNECT_MAX=5
# 重连基础退避（毫秒），实际为 基础 * 2^min(尝试次数,4)（指数退避，封顶 16x）。默认 2000。
MCP_RECONNECT_DELAY_MS=2000
# 后台健康探测周期（毫秒）；<=0 关闭探测（关闭后仅工具调用失败时才懒重连）。默认 60000。
MCP_HEALTH_INTERVAL_MS=60000
# 单次健康探测（ping）超时（毫秒）。默认 5000。
MCP_HEALTH_TIMEOUT_MS=5000

# ===== Web Playground 安全加固（部署公网前必看） =====
# 1) 接口鉴权：设置后，除健康检查与静态页外的所有 API 都需
#    `Authorization: Bearer <token>`。前端右上角「访问令牌」输入框填写此值。
#    未设置则保持开放（仅建议本地 / 演示）。
UI_AUTH_TOKEN=
# 2) CORS：允许跨域的来源白名单（逗号分隔）。留空 = 仅同源（默认收紧，不再回 `*`）。
#    若前端与后端不同源，显式填入，例如 https://playground.example.com
UI_CORS_ORIGIN=
# 3) 请求体上限（字节），防大报文 DoS。默认 1MB。
MAX_BODY_BYTES=1048576
# 4) 限流：单 IP 在窗口内的请求数；<=0 关闭。默认 120 次 / 60s。
RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000
# 5) 审计日志落盘路径；留空则仅输出到 stdout（JSON 行）。
#    AUDIT_LOG=/var/log/agent-harness/audit.log
AUDIT_LOG=

# ===== 运行队列（P1-8 架构解耦） =====
# /api/run 提交后进入内存任务队列，由 worker 池异步执行（与 SSE 长连接解耦）。
# 并发执行上限（同时跑的 agent 任务数）；超出部分排队。默认 4。
# RUN_CONCURRENCY=4
# 单 Job 事件重放缓冲上限（防止长任务内存无限增长）；缓冲溢出丢弃最旧事件。默认 500。
# RUN_QUEUE_BUFFER=500
# 运维可经 GET /api/jobs 查看排队/执行数与最近任务概要（需 UI_AUTH_TOKEN）。

# ===== 内容安全护栏（guardrails） =====
# 注入检测敏感度：low | medium | high（默认 medium）。high 会启用强信号标记词（如 dan/jailbreak）。
GUARDRAIL_SENSITIVITY=medium
# 输入最大字符数，超过即拦截（防超大输入 / 资源耗尽）。默认 20000。
GUARDRAIL_MAX_INPUT=20000
# 是否扫描密钥类敏感串（默认 true；false 关闭）。
GUARDRAIL_SECRET_SCAN=true
# 是否做提示词注入检测（默认 true；false 关闭）。
GUARDRAIL_INJECTION_SCAN=true
# 是否在输出侧做 PII 脱敏（默认 true；false 关闭，模型输出原样返回）。
GUARDRAIL_PII=true
# 允许列表：命中这些关键词不会被注入检测拦截（逗号分隔），例如产品名恰好含 "system prompt"。
# GUARDRAIL_ALLOWLIST=system prompt

# ===== 可观测性（telemetry） =====
# 若进程中已安装 @opentelemetry/api 并注册了 Tracer/Meter 提供商，则自动发出 Span 与指标；
# 否则退化为进程内内存聚合（仍可通过 GET /api/metrics 查看）。无需额外依赖。
# 可选：将指标导出到 Collector 时，在宿主侧调用 bindOtelMeter(meter) 即可。

# ===== 成本记账与配额（P1-11） =====
# 单次 run 的 token 预算上限（累计 total_tokens）；超出即中止并返回预算超限提示。留空=不限。
# MAX_TOKENS_PER_RUN=200000
# 单次 run 的成本预算上限（美元，按模型单价估算）；超出即中止。留空=不限。
# MAX_COST_PER_RUN=1.0
# 未登记在单价表中的模型默认计价（USD / 1M tokens）；默认 0（保守不计费，宁可漏计也不虚高）。
# LLM_DEFAULT_PRICE_PROMPT_PER_M=0
# LLM_DEFAULT_PRICE_COMPLETION_PER_M=0

# ===== Provider 故障转移（P1-11） =====
# 同时配置 OPENAI_API_KEY 时，自动用熔断器把 OpenRouter 作 primary、OpenAI 作 secondary；
# primary 连续失败/限流即回落，对主循环透明。设为 false 关闭（仅用 OpenRouter）。
LLM_FAILOVER=true
# 连续失败多少次后熔断（打开电路转走 secondary）。默认 3。
LLM_FAILOVER_THRESHOLD=3
# 熔断打开后多久进入 half-open（尝试 primary 一次）。默认 60000ms。
LLM_FAILOVER_COOLDOWN_MS=60000


