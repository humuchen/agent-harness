# Agent Harness 部署环境变量模板
# 用法：cp .env.example .env 后填入真实值
# 注意：.env 默认已被 .gitignore 忽略，不会被提交（切勿把真实密钥提交到仓库）

# ──────────────────────────────────────────────
# 必填：UI 鉴权令牌（内部多人试用必须设置，否则 UI 对全网开放）
# 生成方式（任选其一）：
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ──────────────────────────────────────────────
UI_AUTH_TOKEN=

# ──────────────────────────────────────────────
# LLM（留空 → 内置 Mock LLM 离线运行，无需密钥即可演示运行时面板）
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# 可选：OpenAI 故障转移（OpenRouter 失败且 LLM_FAILOVER != false 时启用）
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ──────────────────────────────────────────────
# 运行队列（使用 redis overlay 时 REDIS_URL 自动注入，通常不必手填）
# ──────────────────────────────────────────────
REDIS_URL=

# ──────────────────────────────────────────────
# 服务监听
# ──────────────────────────────────────────────
PORT=4173
UI_HOST=0.0.0.0

# ──────────────────────────────────────────────
# 并发 / 限流（可选调优，多人试用可按需上调）
# ──────────────────────────────────────────────
RUN_CONCURRENCY=4
RUN_JOBS_MAX=500
JOB_TIMEOUT_MS=300000
RATE_LIMIT=120

# ──────────────────────────────────────────────
# 持久化（可选，避免容器重启丢失作业/记忆）
#   memory 后端：sqlite | file | ''（默认空 = 内存，重启即丢）
# ──────────────────────────────────────────────
# MEMORY_BACKEND=sqlite
# MEMORY_SQLITE_FILE=./data/memory.db
# 队列文件后端（替代 redis 的轻量方案）：
# RUN_QUEUE_BACKEND=file
# RUN_QUEUE_FILE=./data/queue/run-queue.jsonl

# ──────────────────────────────────────────────
# 鉴权增强（可选）
#   token 模式支持多用户：UI_TOKENS=user1:token1,user2:token2
#   角色权限：UI_ROLE_PERMISSIONS=...
# ──────────────────────────────────────────────
# AUTH_PROVIDER=token
# UI_TOKENS=
# UI_ROLE_PERMISSIONS=
