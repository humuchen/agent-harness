# ============================================================================
# 密钥外部化说明（务必先读）
# ----------------------------------------------------------------------------
# 本文件是「本地开发模板」，已被 .gitignore 忽略的 .env 不会被提交。
# 生产环境请勿把真实密钥写进文件/镜像，改用平台密钥注入（推荐，零改造）：
#   1. 平台直接注入环境变量（Render / K8s / Docker / systemd）：最高优先级，
#      服务启动即读取，无需任何文件。
#   2. SECRETS_FILE：指向一个 JSON 文件（K8s Secret 挂载、Docker secret、
#      Render Secret Files）。例如 SECRETS_FILE=/run/secrets/app.json，
#      文件内容 {"OPENROUTER_API_KEY":"...","UI_AUTH_TOKEN":"..."}。
#   3. 本地 .env：仅开发便利，生产不存在即跳过。
# 加载优先级：平台 env > SECRETS_FILE > .env；任何来源都不会覆盖平台注入的 env。
# 详见 server.ts 启动时的 loadSecrets() 与 README「密钥管理」一节。
# ============================================================================

# ===== Real LLM (OpenRouter — default provider) =====
# Leave OPENROUTER_API_KEY empty to use the built-in mock LLM in examples.
# Get a key at https://openrouter.ai/keys  (store the REAL key in local .env, not here)
OPENROUTER_API_KEY=
# Provider-prefixed slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet  
OPENROUTER_MODEL=agnes-2.5-flash
# Override only if you use a self-hosted OpenRouter-compatible gateway. https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://apihub.agnes-ai.com/v1
# Attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=https://workbuddy.app
OPENROUTER_APP_NAME=agent-harness

# ===== Real LLM (plain OpenAI-compatible, optional) =====
# Use createOpenAILLM() / this block for OpenAI / Azure / local vLLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== 环境平台（EnvPlatform，可插拔后端） =====
# 选择"自助环境治理"后端：harness（默认）| local | k8s。
# - harness：Harness NG Pipeline 客户端；HARNESS_API_KEY 留空即 dry-run（只打印将发出的 API 调用，不真建环境）。
# - local ：零依赖本地后端，真正起一个 node:http 预览服务（开箱即真实可跑，无需任何外部平台）。
# - k8s    ：Kubernetes 后端（需先装可选依赖 @kubernetes/client-node 并配置 KUBECONFIG）。
ENV_PLATFORM=harness

# --- Harness 后端配置（ENV_PLATFORM=harness 时生效） ---
HARNESS_API_KEY=
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=
HARNESS_PROJECT_ID=
HARNESS_API_BASE=https://app.harness.io
HARNESS_PROVISION_PIPELINE_ID=provision-environment
HARNESS_DESTROY_PIPELINE_ID=destroy-ephemeral

# ----- 本地后端配置（ENV_PLATFORM=local 时生效） -----
# 预览目录根（每个 env 一个子目录）；默认 ./data/previews。
ENV_LOCAL_ROOT=./data/previews
# 预览服务绑定的 host（URL 用此 host 暴露）；默认 localhost。
ENV_LOCAL_HOST=localhost

# ----- Kubernetes 后端配置（ENV_PLATFORM=k8s 时生效） -----
# K8S_NAMESPACE=default
# K8S_NAME_PREFIX=agent-env-
# K8S_IMAGE=nginx:alpine            # 默认镜像（也可由 create 工具传入 image 覆盖）
# K8S_REPLICAS=1
# K8S_CONTAINER_PORT=80
# K8S_CPU_LIMIT=500m
# K8S_MEM_LIMIT=256Mi
# K8S_INGRESS_HOST_TEMPLATE=https://{envId}.env.my-company.com   # 设了才建 Ingress，否则只返回集群内 Service DNS
# K8S_POLL_INTERVAL_MS=5000
# K8S_MAX_POLLS=60

# ===== Harness debug (align to your real instance) =====
# Set to 1 to print raw Harness trigger/status JSON — paste it back so we can
# fine-tune statusPath / doneStatuses to your instance's exact response shape.
HARNESS_DEBUG=

# ===== MCP (active when configured) =====
# Set MCP_SERVER_URL to plug a remote MCP server's tools into the agent.
# Transport is auto-detected: URL ending in /sse -> SSE, otherwise Streamable HTTP.
# Context7 (up-to-date library docs) is the first integration, already wired below.
MCP_SERVER_URL=https://mcp.context7.com/mcp
# Optional auth headers for the remote server, comma-separated KEY=VALUE.
# Context7 works without a key; add one (free at context7.com/dashboard) for higher limits:
# MCP_HEADERS=CONTEXT7_API_KEY=your_context7_key
MCP_HEADERS=
# Local server (stdio) alternative:
# MCP_COMMAND=npx
# MCP_ARGS=-y @upstash/context7-mcp
# 多服务（每项独立 transport / headers / command），优先级高于单 URL：
# MCP_SERVERS=[{"name":"context7","serverUrl":"https://mcp.context7.com/mcp","headers":{"CONTEXT7_API_KEY":"x"}},
#              {"name":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]

# ===== MCP 可靠性（自动重连 + 健康探测） =====
# 远端 server 重启 / 网络抖动时自动自愈。默认开启。
MCP_RECONNECT=true
# 自动重连最大尝试次数（达到后停止后台重试，可由 UI 手动「↻ 重连」）。默认 5。
MCP_RECONNECT_MAX=5
# 重连基础退避（毫秒），实际为 基础 * 2^min(尝试次数,4)（指数退避，封顶 16x）。默认 2000。
MCP_RECONNECT_DELAY_MS=2000
# 后台健康探测周期（毫秒）；<=0 关闭探测（关闭后仅工具调用失败时才懒重连）。默认 60000。
MCP_HEALTH_INTERVAL_MS=60000
# 单次健康探测（ping）超时（毫秒）。默认 5000。
MCP_HEALTH_TIMEOUT_MS=5000

# ===== Web Playground 安全加固（部署公网前必看） =====
# 1) 接口鉴权（RBAC）：设置后，除健康检查与静态页外的所有 API 都需
#    `Authorization: Bearer <token>`。前端右上角「访问令牌」输入框填写此值。
#    推荐用 UI_TOKENS 配置多令牌多角色（见下）；UI_AUTH_TOKEN 为兼容旧版的单一令牌（默认 operator）。
#    未设置则保持开放（仅建议本地 / 演示）。
UI_AUTH_TOKEN=
# 多令牌多角色（JSON：{ "<token>": "admin" | "operator" | "viewer" }）。
# 例：UI_TOKENS={"prod-admin-token":"admin","prod-ops-token":"operator","prod-viewer-token":"viewer"}
# UI_TOKENS=
# 角色-权限矩阵覆盖（JSON：{admin:[...],operator:[...],viewer:[...]}），动作见 README。
# UI_ROLE_PERMISSIONS=
# 2) CORS：允许跨域的来源白名单（逗号分隔）。留空 = 仅同源（默认收紧，不再回 `*`）。
#    若前端与后端不同源，显式填入，例如 https://playground.example.com
UI_CORS_ORIGIN=
# 3) 请求体上限（字节），防大报文 DoS。默认 1MB。
MAX_BODY_BYTES=1048576
# 4) 限流：单 IP 在窗口内的请求数；<=0 关闭。默认 120 次 / 60s。
RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000
# 5) 审计日志落盘路径；留空则仅输出到 stdout（JSON 行）。
#    AUDIT_LOG=/var/log/agent-harness/audit.log
AUDIT_LOG=

# ===== RBAC 角色权限矩阵 & 审批工作流（P2-12） =====
# 角色：admin（全权限，且默认绕过审批）/ operator（可执行敏感动作但需审批）/ viewer（仅只读）。
# 权限矩阵可由 UI_ROLE_PERMISSIONS 覆盖（见上方鉴权段）。动作粒度示例：
#   agent:run:mock / agent:run:real / agent:run:real-mcp / verify / env:create / env:destroy /
#   mcp:read / mcp:add / mcp:preset / mcp:reconnect / shell:approve /
#   memory:read / memory:clear / metrics:read / jobs:read / sessions:read / approvals:review
# 审批：敏感动作（real 运行 / 环境创建销毁 / MCP 接入 / 记忆清空 / 验证 / shell 审批）被策略判定为
#   需审批时，服务端返回 202 + ticketId；审批人经 POST /api/approvals/:id 裁决后，原请求方可重发执行。
# 可绕过审批的角色（逗号分隔）；默认 admin。例：UI_APPROVAL_BYPASS_ROLES=admin
# UI_APPROVAL_BYPASS_ROLES=admin
# 运维端点：GET /api/roles（当前权限矩阵）、GET /api/approvals（工单列表）、
#           GET|POST /api/approvals/:id（查看 / 裁决）。均受 RBAC 保护。

# ===== 运行队列（P1-8 架构解耦） =====
# /api/run 提交后进入内存任务队列，由 worker 池异步执行（与 SSE 长连接解耦）。
# 并发执行上限（同时跑的 agent 任务数）；超出部分排队。默认 4。
# RUN_CONCURRENCY=4
# 单 Job 事件重放缓冲上限（防止长任务内存无限增长）；缓冲溢出丢弃最旧事件。默认 500。
# RUN_QUEUE_BUFFER=500
# 单 Job 整体超时（毫秒）：超时后中止循环并释放 worker 槽位，避免任务永久占坑（防挂死）。默认 300000（5 分钟）。
# JOB_TIMEOUT_MS=300000
# jobs 表上限：超出后惰性淘汰「已结束且无人订阅」的最旧 Job，防内存膨胀。默认 500。
# RUN_JOBS_MAX=500
# 队列持久化后端（崩溃可恢复 / 多实例共享）：memory | file | redis（默认 memory）。
# - memory：纯内存，进程重启即丢未完成任务（与改造前一致）。单实例。
# - file：把「已提交但还没开始」的任务意图追加到 JSONL 文件，进程崩溃/重启后自动重放，
#   避免丢活（在飞任务因携带进程内状态不可恢复，客户端会自行重投）。零 npm 依赖。单实例。
# - redis：接入共享 Redis，任务在 pending/processing 双列表间原子流转（claim = LMOVE），
#   多实例部署时任意空闲实例都能领取执行，实现真正的水平扩展；崩溃实例占住的任务由
#   其它实例按租约回收重跑。需自行安装 ioredis（可选依赖，缺失时自动降级 memory）。
# RUN_QUEUE_BACKEND=file
# file 后端落盘路径；默认 ./data/queue/run-queue.jsonl。仅 RUN_QUEUE_BACKEND=file 时生效。
# RUN_QUEUE_FILE=./data/queue/run-queue.jsonl
# Redis 连接串；设了即启用 redis 后端（或被 RUN_QUEUE_BACKEND=redis 显式开启）。默认 redis://localhost:6379。
# REDIS_URL=redis://localhost:6379
# 领取租约（毫秒）：任务被某实例领取后，若超过此时长仍未 ack（= 实例崩溃），其它实例
# 会把它从 processing 迁回 pending 重新领取。默认 300000（5 分钟）。
# QUEUE_LEASE_MS=300000
# 领取轮询间隔（毫秒）：共享后端下 worker 周期性 claim 的节奏；越小任务起跑延迟越低、
# 空转开销略增。默认 3000。
# QUEUE_CLAIM_INTERVAL_MS=3000
# 优雅停机宽限（毫秒）：收到 SIGTERM/SIGINT 后，先中止在飞任务、等待其退出，再关 MCP 与监听。默认 5000。
# RUN_SHUTDOWN_GRACE_MS=5000
# 运维可经 GET /api/jobs 查看排队/执行数与最近任务概要（需 UI_AUTH_TOKEN）。

# ===== 内容安全护栏（guardrails） =====
# 注入检测敏感度：low | medium | high（默认 medium）。high 会启用强信号标记词（如 dan/jailbreak）。
GUARDRAIL_SENSITIVITY=medium
# 输入最大字符数，超过即拦截（防超大输入 / 资源耗尽）。默认 20000。
GUARDRAIL_MAX_INPUT=20000
# 是否扫描密钥类敏感串（默认 true；false 关闭）。
GUARDRAIL_SECRET_SCAN=true
# 是否做提示词注入检测（默认 true；false 关闭）。
GUARDRAIL_INJECTION_SCAN=true
# 是否在输出侧做 PII 脱敏（默认 true；false 关闭，模型输出原样返回）。
GUARDRAIL_PII=true
# 允许列表：命中这些关键词不会被注入检测拦截（逗号分隔），例如产品名恰好含 "system prompt"。
# GUARDRAIL_ALLOWLIST=system prompt

# ===== 可观测性（telemetry） =====
# 若进程中已安装 @opentelemetry/api 并注册了 Tracer/Meter 提供商，则自动发出 Span 与指标；
# 否则退化为进程内内存聚合（仍可通过 GET /api/metrics 查看）。无需额外依赖。
# 可选：将指标导出到 Collector 时，在宿主侧调用 bindOtelMeter(meter) 即可。

# ===== 会话/多租户记忆存储（P1-9） =====
# 记忆后端：volatile | file | sqlite（默认：配了 MEMORY_DIR 用 file，否则 volatile）。
# - volatile：纯内存，无持久化（适合本地/Mock）。
# - file：按会话分桶的 JSON 文件目录（零依赖，单节点落地）。
# - sqlite：Node 22+ 内置 node:sqlite（零 npm 依赖，多租户生产推荐）。
# MEMORY_BACKEND=sqlite
# file 后端目录；每个会话一个 <key>.json。默认 ./data/memory。
# MEMORY_DIR=./data/memory
# sqlite 后端文件；默认 ./data/memory.db。注意：Node 22+ 才内置 node:sqlite，
# 老版本运行期会自动回退到 file 并告警。
# MEMORY_SQLITE_FILE=./data/memory.db
# 多租户隔离方式（前端/调用方决定）：请求携带 x-session-id 头或 body.sessionId，
# 或经 GET/DELETE /api/memory?session=<key> 运维查看/清空。未带则归到 anonymous。

# ===== 成本记账与配额（P1-11） =====
# 单次 run 的 token 预算上限（累计 total_tokens）；超出即中止并返回预算超限提示。留空=不限。
# MAX_TOKENS_PER_RUN=200000
# 单次 run 的成本预算上限（美元，按模型单价估算）；超出即中止。留空=不限。
# MAX_COST_PER_RUN=1.0
# 未登记在单价表中的模型默认计价（USD / 1M tokens）；默认 0（保守不计费，宁可漏计也不虚高）。
# LLM_DEFAULT_PRICE_PROMPT_PER_M=0
# LLM_DEFAULT_PRICE_COMPLETION_PER_M=0

# ===== 闭环步数 / 上下文成本控制（对应 README「已知问题与设计权衡」） =====
# 问题 A（复杂任务闭环提前结束）：单次 run 的循环步数上限。框架默认 12，这里默认提到 24
# 以覆盖更多步骤；复杂任务可显式调大，或在前端「步数上限」输入框按任务覆盖。它是防
# 模型死循环刷工具的安全阀，不建议无上限放开（上限过高会放大成本与耗时）。
# MAX_STEPS=24
# 完成自检：开启后，模型若以「空内容 + 无工具调用」收尾且未达上限，注入系统提示让其
# 继续直到产出实质结果；非空回复一律视为真实最终答案。默认关闭（避免额外成本）。
# AGENT_COMPLETION_CHECK=false
# 问题 B（token 消耗偏大）：工具结果截断阈值（字符）。超过即截断并标注「原长 N 字符」，
# 压低后续步骤的上下文体积与重发成本。复杂任务可调大；机密/长文本场景建议调小。
# MAX_TOOL_RESULT_CHARS=16000
# 滑动窗口容量：窗口溢出时只淘汰非 system 的历史、保留 system 提示词（避免重复注入）。
# MEMORY_WINDOW=20
# 提示词缓存：true/1 时给首条 system 消息打 cache_control: ephemeral，使每步重发的
# system+技能目录可命中提供方缓存、不计重复输入费。默认关闭（个别 provider 对未知字段校验严格）。
# PROMPT_CACHE=false
# 上下文压缩（根治问题 B 的 token 平方增长）：true/1 时，滑动窗口溢出淘汰旧轮次会把它们
# 压缩为一条 system 摘要固定保留，替代「直接丢弃」——模型仍保有早期上下文，但每步重发量
# 从「全部历史」降为「一条摘要」。默认关闭（简单任务关闭时行为与改造前一致，避免任何行为变化）。
# 长任务/高步数场景建议开启。
# CONTEXT_COMPRESSION=false
# 压缩摘要器模式：heuristic（默认，零额外 LLM 调用，仅统计用户请求/工具调用次数）|
# llm（调用模型做高质量摘要，更保真但每次压缩有一次额外的 LLM 调用成本；仅 real 模式生效，
# mock/离线模式即便设为 llm 也会自动回退启发式）。llm 建议在长对话、且已配置便宜摘要模型时启用。
# COMPRESSION_MODE=heuristic

# ===== Provider 故障转移（P1-11） =====
# 同时配置 OPENAI_API_KEY 时，自动用熔断器把 OpenRouter 作 primary、OpenAI 作 secondary；
# primary 连续失败/限流即回落，对主循环透明。设为 false 关闭（仅用 OpenRouter）。
LLM_FAILOVER=true
# 连续失败多少次后熔断（打开电路转走 secondary）。默认 3。
LLM_FAILOVER_THRESHOLD=3
# 熔断打开后多久进入 half-open（尝试 primary 一次）。默认 60000ms。
LLM_FAILOVER_COOLDOWN_MS=60000

# ===== 可观测性：告警通道（P2 收口项） =====
# 所有业务错误已统一经 logError 留结构化日志 + 计数器；emitAlert 进一步把错误/致命事件
# 推送到外部通道。默认关闭（仅本地日志）。可同时启用多个。
# Webhook：把告警 JSON（{level,name,message,fields,ts}）POST 到该地址，如 Slack/飞书/钉钉
# 入站 Webhook 或自研告警网关。示例（占位，请替换为你的真实地址）：
# ALERT_WEBHOOK_URL=https://hooks.example.com/services/xxx/yyy/zzz
# 文件：把告警以 JSON 逐行追加到该文件，便于被 Filebeat/Loki 采集。
# ALERT_LOG_PATH=./data/alerts.log

# ===== 评估与配方版本化（P2-13） =====
# 运行配方（prompt/模型/工具集快照）的落盘目录；不设则纯内存（进程重启清空）。
# 用于把一次成功运行存为命名版本，做回归比对。零 npm 依赖（按 <id>.json 落盘）。
# RECIPE_DIR=./data/recipes
# 评估默认是规则评估器（可解释：护栏/预算/有回答/有工具调用）。要接 LLM-as-judge，
# 仅改 packages/ui/src/eval.ts 的 createEvaluator() 工厂，server 其余代码不动。

# ===== 数据留存 / 出境策略（P2-14） =====
# 各类记录的留存上限（天）；<=0 表示永久。超期记录在导出/聚合时应被剔除。
# RETENTION_DAYS_AUDIT=90
# RETENTION_DAYS_MEMORY=30
# RETENTION_DAYS_RECIPE=365
# 出境/导出前对记录做 PII 脱敏（默认开启）：邮箱/手机号/身份证等被替换占位符。
# 要按数据主权区域差异化合规规则，仅改 packages/ui/src/retention.ts 的 createRetentionPolicy()。

# ===== 版本化 API / OpenAPI（P2-14） =====
# 所有 JSON/SSE 端点同时挂在稳定前缀 /api/v1/*（如 /api/v1/metrics、/api/v1/run），
# 未带前缀的等价路径为向后兼容别名。OpenAPI 3.0 契约见 GET /api/v1/openapi.json
# （受 policy:read 保护）；当前留存策略快照见 GET /api/v1/retention。



