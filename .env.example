# Agent Harness 部署环境变量模板
# 用法：cp .env.example .env 后填入真实值
# 注意：.env 默认已被 .gitignore 忽略，不会被提交（切勿把真实密钥提交到仓库）

# ──────────────────────────────────────────────
# 必填：自定义模型 API Key 加密密钥（AES-256，64 位 hex / 32 bytes）。
# 前端构建（vite define 注入 __AH_CRYPTO_KEY__）与服务端解密共用同一值；
# 更换后已保存的旧密文将无法解密，需重新填写各自定义模型的 API Key。
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AH_CRYPTO_KEY=


# ──────────────────────────────────────────────
# LLM（留空 → 内置 Mock LLM 离线运行，无需密钥即可演示运行时面板）
# ──────────────────────────────────────────────
# 统一认证凭证：该 Key 同时作为「权限校验依据」。
#   - 本地启动即开启鉴权，所有涉及权限校验的逻辑都接受它（admin 角色）。
#   - 现场若未接入 RBAC（未配 UI_TOKENS / UI_AUTH_TOKEN / UI_ROLE_PERMISSIONS / 非 token 身份源），
#     自动降级：OPENROUTER_API_KEY 成为权限判断的【唯一】凭证，保证无 RBAC 场景服务不中断、校验不挂。
#   - 接入 RBAC 后它仍是 admin 逃生通道，与角色权限并行生效。
#   - 服务端会把该 Key 注入 Web 页面 <meta name="ah-api-key">，SPA 自动带 Authorization 头完成认证。
OPEN_API_KEY=
OPEN_MODEL=

# 可选：OpenAI 故障转移（OpenRouter 失败且 LLM_FAILOVER != false 时启用）
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# ──────────────────────────────────────────────
# 运行队列（使用 redis overlay 时 REDIS_URL 自动注入，通常不必手填）
# ──────────────────────────────────────────────
REDIS_URL=

# ──────────────────────────────────────────────
# 服务监听
# ──────────────────────────────────────────────
PORT=4173
UI_HOST=0.0.0.0

# ──────────────────────────────────────────────
# 并发 / 限流（可选调优，多人试用可按需上调）
# ──────────────────────────────────────────────
RUN_CONCURRENCY=4
RUN_JOBS_MAX=500
JOB_TIMEOUT_MS=300000
RATE_LIMIT=120

# ──────────────────────────────────────────────
# 数据库后端（全局开关，影响记忆/账户/历史/插件等所有 SQLite 存储）
#   DB_BACKEND: sqlite（默认，node:sqlite 内置，零依赖）| turso（Turso 云端 SQLite）
#   自动回退：turso 初始化失败时降级为本地 sqlite
# ──────────────────────────────────────────────
# DB_BACKEND=sqlite
# DB_SQLITE_FILE=./data/global.db
# TURSO_URL=libsql://your-db.turso.io
# TURSO_TOKEN=eyJ...（Turso 面板 → Database → Create token）
#   MEMORY_BACKEND: sqlite | file | ''（默认空 = 内存，重启即丢）
#   路径用容器内固定路径 /app/data（由 docker-compose.redis.yml 的 ui-data 卷挂载），
#   不要写相对路径，否则可能落到容器临时层而重建即丢。
# ──────────────────────────────────────────────
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_FILE=/app/data/memory.db
MEMORY_DIR=/app/data/memory
# 医美插件（medical-aesthetics-lead）数据库绝对路径：优先级高于 MEMORY_DIR/plugins/... 与相对 ./data/ma-lead
#   本地开发务必设绝对路径，否则会因启动 cwd 不同把库分散到 packages/server/data 与项目根 data 两处
# MA_DATA_DIR=/app/data/ma-lead

# ──────────────────────────────────────────────
# 医美插件知识检索（外部 RAG 服务，services/rag）
#   配 MA_RAG_BASE_URL 后，project_kb_search 优先走 RAG 检索（合规闸门在 RAG 上保留）；
#   未配则回退本地库 ma_project。RAG 库由插件 scripts/rag-ingest.cjs 从 knowledge/ 母版灌入。
#   向量库落盘：MA_RAG_DATA_FILE（默认 $MA_DATA_DIR/rag-store.json）。
# ──────────────────────────────────────────────
# MA_RAG_BASE_URL=http://localhost:8787
# MA_RAG_TOKEN=
# MA_RAG_DATA_FILE=/app/data/ma-lead/rag-store.json

# ──────────────────────────────────────────────
# 外部 RAG 服务（services/rag）MCP 注册：让 agent 直接拿到 rag__rag_retrieve / rag__rag_ingest
#   先在独立进程启动 RAG（HTTP 或 MCP 模式），再把其暴露给 harness 的 MCP 客户端。
#   HTTP 模式（推荐，便于复用同一份向量库 + 鉴权）：
#     RAG_TRANSPORT=http RAG_PORT=8787 RAG_DATA_FILE=/app/data/ma-lead/rag-store.json node services/rag/dist/index.js
#   再在顶层 env 配 MCP_SERVERS（RAG_* 由子进程继承）：
# ──────────────────────────────────────────────
# MCP_SERVERS=[{"name":"rag","command":"node","args":["services/rag/dist/index.js"],"env":{"RAG_TRANSPORT":"http","RAG_PORT":"8787","RAG_DATA_FILE":"/app/data/ma-lead/rag-store.json"}}]
#   或直接走 MCP stdio 模式（每 agent 进程一个 RAG 子进程）：
# MCP_SERVERS=[{"name":"rag","command":"node","args":["services/rag/dist/index.js"],"env":{"RAG_TRANSPORT":"mcp","RAG_TENANT_ID":"default","RAG_DATA_FILE":"/app/data/ma-lead/rag-store.json"}}]
# 队列文件后端（替代 redis 的轻量单实例方案，需自行挂卷到 ./data/queue）：
# RUN_QUEUE_BACKEND=file
# RUN_QUEUE_FILE=/app/data/queue/run-queue.jsonl

# ──────────────────────────────────────────────
# 鉴权增强（可选）
#   token 模式支持多用户：UI_TOKENS=user1:token1,user2:token2
#   角色权限：UI_ROLE_PERMISSIONS=...
# ──────────────────────────────────────────────
# AUTH_PROVIDER=token
# UI_TOKENS=
# UI_ROLE_PERMISSIONS=

# ──────────────────────────────────────────────
# 账户密码子系统（注册 / 登录，落 SQLite）
# ──────────────────────────────────────────────
# 账户库落点（绝对路径优先；默认 cwd/data/accounts.db）。
# 部署到临时盘（如 Render free）时每次重启清空，建议挂载持久卷并指向该卷目录。
# ACCOUNT_DB_FILE=/app/data/accounts.db
# 账户 token 签名密钥（64 位 hex / 32 bytes）。缺失则回退 AH_CRYPTO_KEY，再缺则每进程随机（重启即失效）。
# AH_AUTH_SECRET=********
# 部署逃生账户：服务启动自动确保该账户存在（库清空或改密时同步）。默认 admin / admin888。
# 在部署面板覆盖 ADMIN_PASSWORD 即可改默认口令；设为空字符串可禁用内置账户。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin888

# ──────────────────────────────────────────────
# GitHub OAuth 登录（登录页"使用 GitHub 登录"按钮）
#   需先在 GitHub → Settings → Developer settings → OAuth Apps 注册应用拿到
#   Client ID / Client Secret；应用回调地址填 https://你的域名/api/account/oauth/github/callback
#   前端按钮仅在 GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET 同时配置时显示。
# ──────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# 可选：显式指定完整回调 URL（含 https）。生产走 TLS 反代（Render/Vercel 等）时无需设置，
# 后端会自动读 X-Forwarded-Proto 推断协议；兜底 localhost→http / 其余→https。
# 若反向代理未注入 X-Forwarded-Proto 且仍走 https，可显式设此变量避免 redirect_uri 协议失配。
# GITHUB_OAUTH_REDIRECT=https://your-domain.com/api/account/oauth/github/callback
# 可选：OAuth 成功后跳回的页面（默认 /）。
# GITHUB_OAUTH_SUCCESS_REDIRECT=/
