# ===== Real LLM (OpenRouter — default provider) =====
# Leave OPENROUTER_API_KEY empty to use the built-in mock LLM in examples.
# Get a key at https://openrouter.ai/keys  (store the REAL key in local .env, not here)
OPENROUTER_API_KEY=
# Provider-prefixed slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only if you use a self-hosted OpenRouter-compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=https://workbuddy.app
OPENROUTER_APP_NAME=agent-harness-ts

# ===== Real LLM (plain OpenAI-compatible, optional) =====
# Use createOpenAILLM() / this block for OpenAI / Azure / local vLLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Harness platform =====
# Leave HARNESS_API_KEY empty to run the agent in dry-run mode
# (it prints the exact API calls it would make, no real provisioning).
HARNESS_API_KEY=
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=
HARNESS_PROJECT_ID=
HARNESS_API_BASE=https://app.harness.io
HARNESS_PROVISION_PIPELINE_ID=provision-environment
HARNESS_DESTROY_PIPELINE_ID=destroy-ephemeral

# ===== Harness debug (align to your real instance) =====
# Set to 1 to print raw Harness trigger/status JSON — paste it back so we can
# fine-tune statusPath / doneStatuses to your instance's exact response shape.
HARNESS_DEBUG=

# ===== MCP (active when configured) =====
# Set MCP_SERVER_URL to plug a remote MCP server's tools into the agent.
# Transport is auto-detected: URL ending in /sse -> SSE, otherwise Streamable HTTP.
# Context7 (up-to-date library docs) is the first integration, already wired below.
MCP_SERVER_URL=https://mcp.context7.com/mcp
# Optional auth headers for the remote server, comma-separated KEY=VALUE.
# Context7 works without a key; add one (free at context7.com/dashboard) for higher limits:
# MCP_HEADERS=CONTEXT7_API_KEY=your_context7_key
MCP_HEADERS=
# Local server (stdio) alternative:
# MCP_COMMAND=npx
# MCP_ARGS=-y @upstash/context7-mcp

# ===== Web Playground 安全加固（部署公网前必看） =====
# 1) 接口鉴权：设置后，除健康检查与静态页外的所有 API 都需
#    `Authorization: Bearer <token>`。前端右上角「访问令牌」输入框填写此值。
#    未设置则保持开放（仅建议本地 / 演示）。
UI_AUTH_TOKEN=
# 2) CORS：允许跨域的来源白名单（逗号分隔）。留空 = 仅同源（默认收紧，不再回 `*`）。
#    若前端与后端不同源，显式填入，例如 https://playground.example.com
UI_CORS_ORIGIN=
# 3) 请求体上限（字节），防大报文 DoS。默认 1MB。
MAX_BODY_BYTES=1048576
# 4) 限流：单 IP 在窗口内的请求数；<=0 关闭。默认 120 次 / 60s。
RATE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000
# 5) 审计日志落盘路径；留空则仅输出到 stdout（JSON 行）。
#    AUDIT_LOG=/var/log/agent-harness/audit.log
AUDIT_LOG=
