{
  "name": "@agent-harness/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile client (Capacitor) for agent-harness: wraps frontend/webapp/dist in a native iOS/Android shell with push, deep-link, file-upload, biometric auth, and offline cache.",
  "scripts": {
    "build": "pnpm --filter @agent-harness/webapp run build && node scripts/cap-sync-guard.mjs",
    "dev": "cap sync && node scripts/splash-copy.mjs && cap open ios",
    "dev:android": "cap sync && node scripts/splash-copy.mjs && cap open android",
    "sync": "cap sync && node scripts/splash-copy.mjs",
    "splash:copy": "node scripts/splash-copy.mjs",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "^5.4.5"
  }
}
