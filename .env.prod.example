# .env.prod.example —— 生产部署环境变量模板（P1-1）
#
# 用法：
#   cp .env.prod.example .env.prod
#   # 填入实际值（此文件不含任何真实密钥，仅模板）
#   docker compose \
#     -f docker-compose.yml \
#     -f docker-compose.redis.yml \
#     -f docker-compose.prod.yml \
#     --profile redis \
#     --env-file .env.prod \
#     up -d --build
#
# ⚠️ .env.prod 必须加入 .gitignore（已有规则覆盖 .env*，确认勿提交）。
# ⚠️ 生产部署前必读 deploy/k8s/DEPLOY-CHECKLIST.md。

# ═══════════════════════════════════════════════════════════
# 必填：密钥与签名（缺失则容器启动阻断）
# ═══════════════════════════════════════════════════════════

# 账户 token 签名密钥（32+ 字符随机串）。
# 生成方式：openssl rand -base64 48
AH_CRYPTO_KEY=

# 认证 cookie 签名密钥（可与 AH_CRYPTO_KEY 不同，32+ 字符随机串）。
AH_AUTH_SECRET=

# 站点 admin API Key（独立于 LLM 密钥，避免双用途）。
ADMIN_API_KEY=

# Redis 密码（Redis 强制 requirepass）。
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# 必填：LLM 密钥（至少一个，BYOK 架构）
# ═══════════════════════════════════════════════════════════

# 用户自带 LLM 密钥（OpenAI / OpenRouter 等）
OPEN_API_KEY=
OPEN_MODEL=

# 平台兜底 Key（未自带 Key 的用户回退到此；需 ALLOW_PLATFORM_KEY=true 才生效）
PLATFORM_OPEN_API_KEY=
ALLOW_PLATFORM_KEY=

# ═══════════════════════════════════════════════════════════
# 可选：容器资源限制
# ═══════════════════════════════════════════════════════════

# 单容器内存上限（docker compose deploy.resources.limits.memory）
CONTAINER_MEMORY_LIMIT=2g

# 单容器 CPU 上限（核数）
CONTAINER_CPU_LIMIT=2.0

# Redis 最大内存
REDIS_MAXMEMORY=512mb

# ═══════════════════════════════════════════════════════════
# 可选：安全加固
# ═══════════════════════════════════════════════════════════

# 可信代理网段（收窄为实际反代所在网段，防伪造 XFF 绕过限流）
TRUST_PROXY_CIDRS=172.16.0.0/12,127.0.0.0/8,::1/128

# 出网管控模式（open=不限制 / denylist=黑名单 / allowlist=白名单）
GUARDRAIL_NETWORK_MODE=denylist

# denylist 模式下禁止的域名（逗号分隔，支持 *.example.com 通配子域）
GUARDRAIL_DENIED_DOMAINS=

# 是否豁免私有网络地址（生产建议 false，防 SSRF）
GUARDRAIL_ALLOW_PRIVATE_NETWORK=false

# ═══════════════════════════════════════════════════════════
# 可选：成本与备份
# ═══════════════════════════════════════════════════════════

# 每窗口最大成本（美元）
MAX_COST_PER_WINDOW=50

# 备份保留天数
AH_BACKUP_KEEP_DAYS=30

# ═══════════════════════════════════════════════════════════
# 可选：成果物对象存储（S3 兼容）
# ═══════════════════════════════════════════════════════════

# 留空则使用本地存储（落 /app/data/artifacts）；设为 s3 则上传到对象存储。
ARTIFACT_STORE=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ═══════════════════════════════════════════════════════════
# 可选：告警 webhook（Slack/飞书/钉钉入站 Webhook）
# ═══════════════════════════════════════════════════════════

# 留空则仅落文件告警（/app/data/alerts.jsonl）。
ALERT_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════
# 可选：RAG / 外部集成
# ═══════════════════════════════════════════════════════════

# 外部 RAG 接入（HermesChat 等）
RAG_URL=
RAG_API_STYLE=
RAG_TOKEN=
RAG_TIMEOUT_MS=180000

# RAG 生成层 LLM
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=agnes-3.0-flash

# Embedding 端点
RAG_EMBEDDING_ENDPOINT_URL=http://host.docker.internal:8001/embeddings
RAG_EMBED_DIM=1024
