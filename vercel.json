{
  "$schema": "https://json.schemastore.org/vercel.json",
  "name": "agent-harness",
  "builds": [
    {
      "src": "access/server/package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/webapp/dist/**",
          "backend/core/dist/**",
          "backend/client/dist/**",
          "services/rag/dist/**",
          "plugins/**/dist/**",
          "scripts/**",
          "pnpm-workspace.yaml",
          "package.json"
        ],
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/access/server/package.json" },
    { "src": "/(.*)",       "dest": "/access/server/package.json" }
  ]
}
