{
  // P1#34 精简：extends tsconfig.base.json 后仅覆写真实差异项——
  //   lib +DOM（跨运行时 SDK 的浏览器消费方）、types []（不能带 node types，
  //   Web/Edge 环境无 node: 模块）、noUncheckedIndexedAccess（严格度增项）。
  // 此前覆写了与 base 逐字相同的 9 项（target/module/strict 等），继承形同虚设。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
