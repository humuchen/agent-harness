{
  "name": "@agent-harness/core",
  "version": "1.0.0",
  "description": "Minimal, runnable TypeScript LLM agent harness core (tool loop, memory, guardrails, telemetry, MCP).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "make -C native/sandbox-exec",
    "test": "tsc -p tsconfig.json && node --test test/*.test.cjs"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.14.0",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.4.5"
  }
}
