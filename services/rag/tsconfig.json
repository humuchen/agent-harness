{
  // P1#34 裁定：有意不 extends tsconfig.base.json——本服务独立部署（node dist/index.js
  // 直接运行 / node --test require dist/），module=NodeNext + package.json type:module
  // 输出 ESM；lib 含 DOM（看板 HTML 模板字符串的类型辅助）。
  // 与 base 的一致项：strict / noUncheckedIndexedAccess / ES2022 target。
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["../../backend/core/node_modules/@types", "../../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
