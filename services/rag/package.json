{
  "name": "@agent-harness/rag-service",
  "version": "1.0.0",
  "private": true,
  "description": "External RAG (retrieval-augmented generation) service for agent-harness: ingest + vector store + retrieve over HTTP/MCP.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/obfuscate.mjs",
    "build:raw": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js",
    "start:mcp": "RAG_TRANSPORT=mcp node dist/index.js",
    "test": "node --test test/*.test.cjs",
    "test:golden": "node --test test/golden-dataset.test.cjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
